# =============================================================================
# Jayyid Autos - environment configuration
#
# Copy to ".env" and fill in the values for the machine it runs on, then run
# `php artisan key:generate`. Never commit .env or real keys.
# =============================================================================

APP_NAME="Jayyid Autos"
# local | staging | production
APP_ENV=local
APP_KEY=
# Must be false in production.
APP_DEBUG=true
# Public base URL, no trailing slash. Used for links in emails and gateway callbacks.
APP_URL=http://localhost/jayyid-autos
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL / MariaDB, e.g. XAMPP)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jayyid_autos
DB_USERNAME=root
DB_PASSWORD=admin

# File-based sessions and cache need no extra tables; switch to "database"
# (tables are created by the migrations) when running several web servers.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local
# "sync" sends mail during the request; use "database" with `php artisan queue:work` to offload it.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Mail - Resend (sign-up verification codes, staff invites, receipts, alerts)
# Key: https://resend.com/api-keys
# With MAIL_MAILER=log no email is sent: sign-up skips email verification and
# staff invite links are shown to the administrator instead.
# MAIL_FROM_ADDRESS must be on a domain verified in Resend; onboarding@resend.dev
# only delivers to the address that owns the Resend account.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Payments - Paystack
# Keys: https://dashboard.paystack.com/#/settings/developers
# Use the pk_test_/sk_test_ pair while testing, pk_live_/sk_live_ in production.
# Leave PAYSTACK_SECRET_KEY empty to keep checkout in simulated preview mode.
# Webhook URL to register: {APP_URL}/webhooks/paystack
# The Bank Transfer option needs "Pay with Transfer" enabled on the account.
# -----------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN

# -----------------------------------------------------------------------------
# Payments - PayPal
# Keys: https://developer.paypal.com/dashboard/applications
# PAYPAL_MODE=sandbox uses api-m.sandbox.paypal.com; use "live" in production.
# Leave PAYPAL_CLIENT_ID or PAYPAL_SECRET empty to keep the PayPal tab in preview.
# Webhook URL to register: {APP_URL}/webhooks/paypal
# -----------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# PayPal does not accept naira: charges are converted to this currency at the
# rate set in Admin > Settings. PAYPAL_EXCHANGE_RATE (naira per 1 unit) is the
# starting rate until staff save one. No rate = PayPal unavailable at checkout.
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=
PAYPAL_WEBHOOK_ID=

# -----------------------------------------------------------------------------
# SEO
# robots.txt only allows crawling when APP_ENV=production (staging stays hidden).
# Showroom coordinates for local search (Google Maps: right-click the pin).
# Social profiles (Instagram, Facebook, X, Google Business Profile), comma separated.
# Verification tokens from Google Search Console / Bing Webmaster Tools.
# -----------------------------------------------------------------------------
SHOWROOM_LATITUDE=6.6018
SHOWROOM_LONGITUDE=3.3515
SHOWROOM_SOCIAL_PROFILES=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
