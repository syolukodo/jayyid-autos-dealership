# Serves the Laravel app when the web root is this project folder (e.g. XAMPP
# at http://localhost/jayyid-autos-dealership). Where you control the server, point the
# document root at public/ instead and this file is ignored.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Static files (CSS, JS, images, uploads) are served straight from public/.
    # (robots.txt and sitemap.xml are generated by Laravel.)
    RewriteRule ^((?:assets|uploads|storage)/.+|favicon\.ico)$ public/$1 [L]

    # Everything else - including any attempt to reach .env, app/, storage/ or
    # vendor/ directly - goes to the Laravel front controller.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule !^index\.php$ index.php [L]
</IfModule>

# Without mod_rewrite nothing in the project root may be served.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

# Defence in depth: never serve environment files (including a stray "env").
<FilesMatch "^\.?env(\..*)?$">
    Require all denied
</FilesMatch>
